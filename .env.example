# ── Admin initial (seed DB) ────────────────────────────────────────
# Si la table `users` est vide au démarrage, un compte admin est créé avec ces identifiants.
# Ensuite la gestion des comptes se fait dans l’app (menu Comptes, réservé admin).
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Secret de signature des cookies de session (obligatoire en prod)
SESSION_SECRET=change-me-to-a-long-random-string

# Compat : anciennes variables encore lues si ADMIN_* absentes
# AUTH_USER=admin
# AUTH_PASS=changeme

# Server
PORT=3001
# DEBUG global backend (HTTP + erreurs + DB)
# BACKEND_DEBUG=1
# Ou séparément :
# DEBUG_HTTP=1
# DEBUG_ERRORS=1
# DB_DEBUG=1

# ── Base MySQL ───────────────────────────────────────────────────
# Local : optionnel — sans ces variables, SQLite (better-sqlite3, optionalDependency).
# Hostinger : OBLIGATOIRE — better-sqlite3 ne compile pas (glibc trop ancienne).
# Définir DATABASE_URL ou les 4 MYSQL_* ; sinon le boot échoue sans module natif.
# Si définies, TOUTES les données (y compris médias BLOB) vont sur MySQL.
# Exemple Hostinger :
# DATABASE_URL=mysql://user:password@host:3306/nom_base
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# ── Persistance des données (production) ─────────────────────────
# Dossier pour le fichier SQLite local uniquement (si pas de MySQL).
# Les médias sont en BLOB dans media.content — rien sur disque.
# DATA_DIR=data

# ── Génération d'images IA (TSD-012) ────────────────────────────
# Clé OpenAI (Images API : gpt-image-1 par défaut, DALL-E 3 possible).
# Alternative : saisie dans Config > IA (stockée en DB, jamais renvoyée en clair).
# OPENAI_API_KEY=sk-...
